{
    "name": "laravel-elm-devtools",
    "version": "3.1.0",
    "private": true,
    "description": "Chrome DevTools panel for Laravel Elm: inspect the current page's props, state and ports",
    "type": "module",
    "scripts": {
        "build": "npm run build:elm && npm run build:css",
        "build:parser": "peggy --format es -o js/parser.js js/debug-string.peggy",
        "build:elm": "elm make src/Main.elm --optimize --output built/elm.js",
        "build:css": "tailwindcss -i css/main.css -o built/main.css --minify",
        "watch": "node scripts/watch.js",
        "package": "npm run build && node scripts/package.js"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.0",
        "elm": "^0.19.3-0",
        "peggy": "^5.1.1",
        "tailwindcss": "^4.3.0"
    },
    "engines": {
        "node": ">=20.19"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/loganhenson/laravel-elm-devtools.git"
    },
    "author": "Logan Henson",
    "license": "MIT"
}
