{
  "name": "laravel-elm-devtools",
  "version": "2.0.0",
  "description": "Laravel Elm Devtools Extension",
  "main": "background.js",
  "dependencies": {
    "@types/chrome": "^0.0.270",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^8.2.0",
    "elm": "^0.19.1-5",
    "postcss": "^8.4.35",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.0.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {},
  "scripts": {
    "elm": "elm make src/Main.elm --output built/elm.js",
    "css": "postcss css/main.css -o built/main.css",
    "elm:watch": "chokidar 'src/**/*.elm' -c 'npm run elm'",
    "css:watch": "chokidar 'css/**/*.css' -c 'npm run css'",
    "build": "mkdir -p built && npm run elm && npm run css",
    "watch": "npm run build && concurrently \"npm run elm:watch\" \"npm run css:watch\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Logan Henson",
  "license": "MIT"
}
